# Same upload limits as .user.ini, for servers running PHP as an Apache module.
# The IfModule guards matter: php_value under CGI/FastCGI is a fatal 500.
<IfModule mod_php.c>
    php_value upload_max_filesize 12M
    php_value post_max_size 64M
    php_value max_file_uploads 40
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 12M
    php_value post_max_size 64M
    php_value max_file_uploads 40
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 12M
    php_value post_max_size 64M
    php_value max_file_uploads 40
</IfModule>
